{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "visited-map",
  "homepage": "https://visitedmap.vercel.app",
  "items": [
    {
      "name": "visited-map",
      "type": "registry:component",
      "title": "Visited Map",
      "description": "An SVG world map that highlights the countries you've visited, lived in or want to see, pins cities on top and counts how much of the world you've seen. No tiles or API keys; works in Server Components.",
      "dependencies": ["d3-geo", "topojson-client", "world-atlas"],
      "devDependencies": ["@types/d3-geo", "@types/topojson-client"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/visited-map/visited-map.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/visited-map/visited-map-zoom.tsx",
          "type": "registry:component"
        }
      ],
      "categories": ["map", "data-display"]
    }
  ]
}
